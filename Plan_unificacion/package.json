import React, { useState } from "react";
import { Heart, ArrowRight } from "lucide-react";
import { C, S } from "../theme.js";
import { Route } from "../components/UI.jsx";

const COPY = {
  es: {
    tag: "Nuestro reinicio",
    line1: "Un plan. Dos corazones.",
    line2: "Un mismo destino.",
    cta: "Comenzar nuestro plan",
    placeholder: "Tu clave personal",
    hint: "Una sola vez por teléfono. Después entra solo.",
    wrong: "Esa clave no es. Probá de nuevo.",
    foot: "Hecho con propósito, amor y café",
  },
  en: {
    tag: "Our restart",
    line1: "One plan. Two hearts.",
    line2: "One destination.",
    cta: "Start our plan",
    placeholder: "Your personal code",
    hint: "Once per phone. After that it opens straight in.",
    wrong: "That code isn't right. Try again.",
    foot: "Made with purpose, love, and coffee",
  },
};

export default function Landing({ lang, setLang, onSuccess }) {
  const c = COPY[lang];
  const [code, setCode] = useState("");
  const [error, setError] = useState(false);
  const [busy, setBusy] = useState(false);

  const submit = async () => {
    if (!code.trim() || busy) return;
    setBusy(true);
    setError(false);
    try {
      const res = await fetch("/api/login", {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ code }),
      });
      if (!res.ok) throw new Error("nope");
      const data = await res.json();
      onSuccess(data.person);
    } catch (e) {
      setError(true);
      setCode("");
      setBusy(false);
    }
  };

  return (
    <div style={{ ...S.screen, paddingBottom: 40, display: "flex", flexDirection: "column" }}>
      <div style={{ ...S.wrap, paddingTop: 34, flex: 1, display: "flex", flexDirection: "column" }}>
        <Route pct={52} />

        <div style={{ textAlign: "center", marginTop: 24 }}>
          <h1 style={{
            fontFamily: "Caveat, cursive", fontSize: 52, lineHeight: 0.95,
            color: C.green, margin: 0, fontWeight: 700,
          }}>
            Plan de<br />Unificación
          </h1>
          <div style={{ ...S.script, fontSize: 26, marginTop: 6 }}>
            {c.tag} <Heart size={15} fill={C.rose} color={C.rose} style={{ verticalAlign: "middle" }} />
          </div>
        </div>

        <p style={{ textAlign: "center", color: C.inkSoft, fontSize: 14.5, lineHeight: 1.6, marginTop: 18 }}>
          {c.line1}<br />{c.line2}
        </p>

        <div style={{
          flex: 1, minHeight: 140, margin: "18px 0", borderRadius: 26, overflow: "hidden",
          background: "linear-gradient(180deg, " + C.creamDeep + ", " + C.roseSoft + ")",
          display: "flex", alignItems: "center", justifyContent: "center",
        }}>
          <img src="/reinicio.jpg" alt="Nuestro reinicio" style={{
            width: "66%", maxWidth: 230, borderRadius: 20,
            boxShadow: "0 12px 40px rgba(36,49,45,0.18)", transform: "rotate(-2deg)",
          }} />
        </div>

        <input
          value={code}
          onChange={(e) => setCode(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && submit()}
          placeholder={c.placeholder}
          autoCapitalize="none"
          autoCorrect="off"
          style={{
            ...S.input, textAlign: "center", fontSize: 17, fontWeight: 700,
            padding: "15px 13px", letterSpacing: "0.04em",
            borderColor: error ? C.red : C.line,
          }}
        />

        {error && (
          <div style={{ textAlign: "center", color: C.red, fontSize: 12.5, fontWeight: 600, marginTop: 8 }}>
            {c.wrong}
          </div>
        )}

        <button onClick={submit} disabled={busy} style={{
          ...S.btn, width: "100%", marginTop: 12, opacity: busy ? 0.6 : 1,
          display: "flex", alignItems: "center", justifyContent: "center", gap: 10,
          fontSize: 16, padding: "17px 22px",
        }}>
          {c.cta} <ArrowRight size={17} />
        </button>

        <div style={{ textAlign: "center", fontSize: 11.5, color: C.inkFaint, marginTop: 10 }}>
          {c.hint}
        </div>

        <div style={{
          display: "flex", background: C.card, border: "1px solid " + C.line,
          borderRadius: 999, padding: 4, marginTop: 16,
        }}>
          {[["es", "Español"], ["en", "English"]].map(([k, label]) => (
            <button key={k} onClick={() => setLang(k)} style={{
              flex: 1, border: "none", borderRadius: 999, padding: "10px 6px",
              fontSize: 13.5, fontWeight: 700,
              background: lang === k ? C.roseSoft : "transparent",
              color: lang === k ? C.roseDeep : C.inkSoft,
            }}>{label}</button>
          ))}
        </div>

        <div style={{ textAlign: "center", fontSize: 11.5, color: C.inkFaint, margin: "16px 0 6px" }}>
          {c.foot}
        </div>
      </div>
    </div>
  );
}
